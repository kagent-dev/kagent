Pulled: ghcr.io/kagent-dev/kagent/helm/kagent:1.0.0-rc1
Digest: sha256:372385ceb67ea2281645ca3755c27861f8b5dc0b60c8149995e658d46f5737e8
---
# Source: kagent/templates/controller-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kagent-controller
  namespace: kagent
  labels:
    helm.sh/chart: kagent-1.0.0-rc1
    app.kubernetes.io/name: kagent
    app.kubernetes.io/instance: kagent
    app.kubernetes.io/version: "1.0.0-rc1"
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/part-of: kagent
    app.kubernetes.io/component: controller
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: kagent
      app.kubernetes.io/instance: kagent
      app.kubernetes.io/component: controller
  template:
    metadata:
      annotations:
        checksum/configmap: 1ea4222a61ce59b6325aa303e15c09e0eee77cb47b3a38dc9a536c213430593c
      labels:
        app.kubernetes.io/component: controller
        app.kubernetes.io/instance: kagent
        app.kubernetes.io/name: kagent
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: "kagent-controller"
      volumes:
      - name: controller-config
        configMap:
          name: kagent-controller
      - name: controller-secrets
        projected:
          sources:
          - secret:
              name: kagent-postgres-readwrite
              items:
              - key: readWriteConnectionString
                path: database-readwrite-url
          - secret:
              name: kagent-postgres-owner
              items:
              - key: ownerConnectionString
                path: database-owner-url
      containers:
        - name: controller
          image: "ghcr.io/kagent-dev/kagent/controller:1.0.0-rc1"
          imagePullPolicy: IfNotPresent
          args: ["--config=/etc/kagent/controller.yaml"]
          env:
            # Private pod identity defaults; explicit OTEL resource attributes win.
            - name: K8S_POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: K8S_POD_UID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.uid
            - name: K8S_NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          ports:
            - name: http
              containerPort: 8083
              protocol: TCP
          resources:
            limits:
              cpu: 2
              memory: 512Mi
            requests:
              cpu: 100m
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
          startupProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 15
            initialDelaySeconds: 15
          readinessProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 30
          volumeMounts:
            - name: controller-config
              mountPath: /etc/kagent
              readOnly: true
            - name: controller-secrets
              mountPath: /etc/kagent/secrets
              readOnly: true
