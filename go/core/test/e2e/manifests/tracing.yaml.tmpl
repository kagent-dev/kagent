apiVersion: kagent.dev/v1alpha3
kind: Harness
metadata:
  name: claude-tracing-e2e
  namespace: kagent
spec:
  claude: {}
  workload:
    image: ${KAGENT_E2E_CLAUDE_IMAGE}
  env:
  # Keep the batch processor's timer from exporting during the test. Because
  # this interaction stays below the batch-size threshold, a2a.request can
  # reach the receiver only through the explicit pre-suspension ForceFlush.
  - name: OTEL_BSP_SCHEDULE_DELAY
    value: "3600000"
  substrate:
    workerPoolRef:
      name: kagent-default
    snapshotPolicy:
      location: gs://ate-snapshots/kagent/
  allowedAgentTemplates:
    selector:
      matchLabels:
        kagent.dev/e2e-runtime: claude-tracing
---
apiVersion: kagent.dev/v1alpha3
kind: Harness
metadata:
  name: codex-tracing-e2e
  namespace: kagent
spec:
  codex: {}
  workload:
    image: ${KAGENT_E2E_CODEX_IMAGE}
  env:
  - name: OTEL_BSP_SCHEDULE_DELAY
    value: "3600000"
  substrate:
    workerPoolRef:
      name: kagent-default
    snapshotPolicy:
      location: gs://ate-snapshots/kagent/
  allowedAgentTemplates:
    selector:
      matchLabels:
        kagent.dev/e2e-runtime: codex-tracing
