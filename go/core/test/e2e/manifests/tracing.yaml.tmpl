# Substrate egress rules match DNS names. Route OTLP to the test host through
# a Service so the runtime allowlist can name this destination explicitly.
apiVersion: v1
kind: Service
metadata:
  name: e2e-otlp
  namespace: kagent
spec:
  ports:
  - name: otlp
    port: 14317
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: e2e-otlp
  namespace: kagent
  labels:
    kubernetes.io/service-name: e2e-otlp
    endpointslice.kubernetes.io/managed-by: kagent-e2e
addressType: IPv4
ports:
- name: otlp
  protocol: TCP
  port: 14317
endpoints:
- addresses: ["${KAGENT_E2E_LOCAL_HOST}"]
  conditions:
    ready: true
---
apiVersion: api.kagent.dev/v1alpha3
kind: Harness
metadata:
  name: claude-tracing-e2e
  namespace: kagent
spec:
  claude: {}
  workload:
    image: ${KAGENT_E2E_CLAUDE_IMAGE}
  env:
  # Keep the batch processor's timer from exporting during the test. Because
  # this interaction stays below the batch-size threshold, a2a.request can
  # reach the receiver only through the explicit pre-suspension ForceFlush.
  - name: OTEL_BSP_SCHEDULE_DELAY
    value: "3600000"
  substrate:
    workerPoolRef:
      name: kagent-default
    snapshotPolicy:
      location: gs://ate-snapshots/kagent/
---
apiVersion: api.kagent.dev/v1alpha3
kind: Harness
metadata:
  name: codex-tracing-e2e
  namespace: kagent
spec:
  codex: {}
  workload:
    image: ${KAGENT_E2E_CODEX_IMAGE}
  env:
  - name: OTEL_BSP_SCHEDULE_DELAY
    value: "3600000"
  substrate:
    workerPoolRef:
      name: kagent-default
    snapshotPolicy:
      location: gs://ate-snapshots/kagent/
