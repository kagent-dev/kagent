{
  "anthropic": [
    {
      "name": "claude_workspace_probe",
      "match": {
        "match_type": "contains",
        "message": {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "Probe the claude workspace."
            }
          ]
        }
      },
      "response": {
        "id": "msg_workspace_probe",
        "type": "message",
        "role": "assistant",
        "content": [
          {
            "type": "tool_use",
            "id": "toolu_workspace_probe",
            "name": "Bash",
            "input": {
              "command": "printf 'pwd=%s\\n' \"$(pwd)\"\nfor repository in e2e/alpha e2e/beta; do\n  if [ -f \"$repository/.git/objects/info/alternates\" ]; then printf '%s alternates=%s\\n' \"$repository\" \"$(cat \"$repository/.git/objects/info/alternates\")\"; fi\n  printf '%s tree=%s\\n' \"$repository\" \"$(ls -A \"$repository\" 2>/dev/null | grep -vx .git | wc -l | tr -d ' ')\"\n  printf '%s origin=%s\\n' \"$repository\" \"$(git -C \"$repository\" rev-parse origin/main 2>/dev/null)\"\ndone\nif git -C e2e/beta switch --quiet main 2>/dev/null; then printf 'switched=%s\\n' \"$(ls e2e/beta | tr '\\n' ' ')\"; fi\nprintf 'probe=%s\\n' done\n"
            }
          }
        ],
        "model": "claude-sonnet-4-5",
        "stop_reason": "tool_use",
        "usage": {
          "input_tokens": 10,
          "output_tokens": 4
        }
      }
    },
    {
      "name": "claude_workspace_probe_result",
      "match": {
        "match_type": "contains",
        "message": {
          "role": "user",
          "content": [
            {
              "type": "tool_result",
              "tool_use_id": "toolu_workspace_probe",
              "content": [{"type": "text", "text": "probe=done"}]
            }
          ]
        }
      },
      "response": {
        "id": "msg_workspace_done",
        "type": "message",
        "role": "assistant",
        "content": [
          {
            "type": "text",
            "text": "CLAUDE_WORKSPACE_PROBED"
          }
        ],
        "model": "claude-sonnet-4-5",
        "stop_reason": "end_turn",
        "usage": {
          "input_tokens": 10,
          "output_tokens": 4
        }
      }
    },
    {
      "name": "claude_workspace_auxiliary",
      "match": {
        "match_type": "contains",
        "message": {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": ""
            }
          ]
        }
      },
      "response": {
        "id": "msg_workspace_auxiliary",
        "type": "message",
        "role": "assistant",
        "content": [
          {
            "type": "text",
            "text": "OK"
          }
        ],
        "model": "claude-sonnet-4-5",
        "stop_reason": "end_turn",
        "usage": {
          "input_tokens": 10,
          "output_tokens": 4
        }
      }
    }
  ]
}
