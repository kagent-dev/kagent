{
  "$defs": {
    "kagent.api.v1.InvokeSessionOutput.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "default": "",
          "type": "string"
        },
        "session_id": {
          "default": "",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "pattern": "^TASK_STATE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "TASK_STATE_SUBMITTED",
                "TASK_STATE_WORKING",
                "TASK_STATE_COMPLETED",
                "TASK_STATE_FAILED",
                "TASK_STATE_CANCELED",
                "TASK_STATE_INPUT_REQUIRED",
                "TASK_STATE_REJECTED",
                "TASK_STATE_AUTH_REQUIRED"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Task State"
        },
        "task_id": {
          "default": "",
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Invoke Session Output",
      "type": "object"
    }
  },
  "$id": "kagent.api.v1.InvokeSessionOutput.jsonschema.bundle.json",
  "$ref": "#/$defs/kagent.api.v1.InvokeSessionOutput.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
