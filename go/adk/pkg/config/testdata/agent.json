          "model": "model-sap_ai_core",
          "sap_ai_core": {}
        }
      },
      {
        "name": "foundry",
        "model": {
          "model": "model-foundry",
          "foundry": {}
        }
      },
      {
        "name": "mistral",
        "model": {
          "model": "model-mistral",
          "mistral": {}
        }
      }
    ],
    "output": {
      "json_schema": "eyJ0eXBlIjoib2JqZWN0IiwicHJvcGVydGllcyI6eyJhbnN3ZXIiOnsidHlwZSI6InN0cmluZyJ9fX0=",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  }
}
