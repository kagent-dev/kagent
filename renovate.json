// The Giant Swarm line of kagent-dev/kagent. Renovate is off here on
// purpose for everything upstream owns: this line is an upstream release
// plus the carried patches, so upstream owns the dependency graph. A bump
// opened here would diverge from the pinned upstream release and every
// re-pin would have to carry or revert it. Dependencies move when the line
// is re-pinned; see FORK.md.
//
// The one exception is what a carried patch pins itself: the GitHub CLI in
// the Go runtime and Claude harness images (go/github-cli.version), the
// GitLab CLI in the Claude harness image (go/gitlab-cli.version), and the
// Claude Code, Codex and omp CLIs of the harness images (the ARG lines of
// go/harness/{claude,codex,omp}/Dockerfile and the Pinned*Version constant the
// harness checks the installed binary against). Only the regex managers below
// run, so no other manager opens a pull request.
//
// This repository is a GitHub fork, which Renovate skips unless its default
// config file, renovate.json (never renovate.json5), sets forkProcessing to
// enabled; hence this file's name. The Dependency Dashboard is on: with two
// tracked dependencies that are usually current, it is the only visible trace
// that Renovate scans this line and what it tracks.
{
  "reviewers": ["teemow"],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "forkProcessing": "enabled",
  "dependencyDashboard": true,
  // The harness-pins workflow commits the vendors' checksums to a CLI bump's
  // branch as the heraldbot App; Renovate keeps managing (and rebasing) a
  // branch whose only other commits are the App's.
  "gitIgnoredAuthors": ["149080493+heraldbot[bot]@users.noreply.github.com"],
  "enabledManagers": ["custom.regex"],
  "packageRules": [
    {
      // A bump of a harness CLI is one reviewable pull request: the image's ARG
      // lines and the Go constant move together.
      "matchDepNames": ["claude-code", "codex-cli", "oh-my-pi"],
      "prBodyNotes": [
        "The image installs the vendor's binary by `*_SHA256` ARGs, which Renovate does not move: the `Harness CLI pins` workflow commits the vendor's checksums to this branch (`scripts/fork/harness-pins.sh update`), and the fork-ledger check is red until it has. For Claude Code also recheck the telemetry gate in `go/harness/claude/internal/driver` (see `PinnedClaudeVersion`)."
      ]
    }
  ],
  "customManagers": [
    {
      // The GitHub CLI release both images install (go/install-github-cli.sh):
      // one line per architecture, "<tag> <arch> <sha256 of the release's
      // linux tarball>". The datasource moves the tag and takes the new
      // tarball's checksum from the release's checksums file, so a bump never
      // leaves the two apart.
      "customType": "regex",
      "managerFilePatterns": ["/^go/github-cli\\.version$/"],
      "matchStrings": [
        "(?<currentValue>v\\S+) amd64 (?<currentDigest>[0-9a-f]{64})",
        "(?<currentValue>v\\S+) arm64 (?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "github-cli",
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "cli/cli"
    },
    {
      // Alpine's glab package, from the Alpine release of
      // go/harness/claude/Dockerfile.
      "customType": "regex",
      "managerFilePatterns": ["/^go/gitlab-cli\\.version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "glab",
      "datasourceTemplate": "repology",
      "packageNameTemplate": "alpine_3_24/glab",
      "versioningTemplate": "loose"
    },
    {
      // Claude Code: the tag of go/harness/claude/Dockerfile and the version
      // the harness expects of the installed binary. The two per-architecture
      // sha256 ARGs are the vendor manifest's checksums
      // (downloads.claude.ai/claude-code-releases/<version>/manifest.json), a
      // per-version document no Renovate datasource reads, so they do not move
      // here: the harness-pins workflow refreshes them on Renovate's branch
      // (scripts/fork/harness-pins.sh update), and the script's check, a step of
      // the fork-ledger workflow, fails a pull request that leaves them stale.
      "customType": "regex",
      "managerFilePatterns": [
        "/^go/harness/claude/Dockerfile$/",
        "/^go/harness/claude/config/config\\.go$/"
      ],
      "matchStrings": [
        "ARG CLAUDE_CODE_VERSION=(?<currentValue>\\S+)",
        "PinnedClaudeVersion\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "claude-code",
      "datasourceTemplate": "npm",
      "packageNameTemplate": "@anthropic-ai/claude-code"
    },
    {
      // Codex: the tag of go/harness/codex/Dockerfile and the version the
      // harness expects of the installed binary. The checksums move with the
      // harness-pins workflow, as for Claude Code above.
      "customType": "regex",
      "managerFilePatterns": [
        "/^go/harness/codex/Dockerfile$/",
        "/^go/harness/codex/config/config\\.go$/"
      ],
      "matchStrings": [
        "ARG CODEX_CLI_VERSION=(?<currentValue>\\S+)",
        "PinnedCodexVersion\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "codex-cli",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "openai/codex",
      "extractVersionTemplate": "^rust-v(?<version>.+)$"
    },
    {
      // omp (oh-my-pi): the tag of go/harness/omp/Dockerfile and the version
      // the harness expects of the installed binary. The checksums (the
      // release's SHA256SUMS.txt) move with the harness-pins workflow, as for
      // Claude Code above.
      "customType": "regex",
      "managerFilePatterns": [
        "/^go/harness/omp/Dockerfile$/",
        "/^go/harness/omp/internal/config/config\\.go$/"
      ],
      "matchStrings": [
        "ARG OMP_VERSION=(?<currentValue>\\S+)",
        "PinnedOmpVersion\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "oh-my-pi",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "can1357/oh-my-pi",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
