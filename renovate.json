// The Giant Swarm line of kagent-dev/kagent. Renovate is off here on
// purpose for everything upstream owns: this line is an upstream release
// plus the carried patches, so upstream owns the dependency graph. A bump
// opened here would diverge from the pinned upstream release and every
// re-pin would have to carry or revert it. Dependencies move when the line
// is re-pinned; see FORK.md.
//
// The one exception is what a carried patch pins itself: the GitHub CLI in
// the Go runtime and Claude harness images (go/github-cli.version) and the
// GitLab CLI in the Claude harness image (go/gitlab-cli.version). Only the
// regex managers below run, so no other manager opens a pull request.
//
// This repository is a GitHub fork, which Renovate skips unless its default
// config file, renovate.json (never renovate.json5), sets forkProcessing to
// enabled; hence this file's name. The Dependency Dashboard is on: with two
// tracked dependencies that are usually current, it is the only visible trace
// that Renovate scans this line and what it tracks.
{
  "reviewers": ["teemow"],
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "forkProcessing": "enabled",
  "dependencyDashboard": true,
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      // The GitHub CLI release both images install (go/install-github-cli.sh):
      // one line per architecture, "<tag> <arch> <sha256 of the release's
      // linux tarball>". The datasource moves the tag and takes the new
      // tarball's checksum from the release's checksums file, so a bump never
      // leaves the two apart.
      "customType": "regex",
      "managerFilePatterns": ["/^go/github-cli\\.version$/"],
      "matchStrings": [
        "(?<currentValue>v\\S+) amd64 (?<currentDigest>[0-9a-f]{64})",
        "(?<currentValue>v\\S+) arm64 (?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "github-cli",
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "cli/cli"
    },
    {
      // Alpine's glab package, from the Alpine release of
      // go/harness/claude/Dockerfile.
      "customType": "regex",
      "managerFilePatterns": ["/^go/gitlab-cli\\.version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "glab",
      "datasourceTemplate": "repology",
      "packageNameTemplate": "alpine_3_24/glab",
      "versioningTemplate": "loose"
    }
  ]
}
