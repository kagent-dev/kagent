WEAVER_VERSION=v0.27.0
WEAVER_IMAGE=docker.io/otel/weaver:v0.27.0@sha256:3049b4079049d4abb1b5632f511ada2c33505a1c60f3f8535e93f87f0696f056
# The upstream sources of the contract, each a git URL at a pinned commit, which
# `make semconv-deps` puts into telemetry/deps for the registry manifest,
# semconv-check and live-check to read from disk; a fetched checkout is
# compared with its pin.
# The registries telemetry/registry/manifest.yaml depends on. The core registry
# is the commit of its release v1.44.0; the GenAI registry names that release
# by its tag, so the tag is declared beside the commit and a GenAI pin that
# names another release is refused.
SEMCONV_CORE_REGISTRY=https://github.com/open-telemetry/semantic-conventions.git@e10a930844c6951757a43b849d364f7d056ac32b
SEMCONV_CORE_REGISTRY_TAG=v1.44.0
# semantic-conventions-genai has no releases yet, so it is pinned by commit.
SEMCONV_GENAI_REGISTRY=https://github.com/open-telemetry/semantic-conventions-genai.git@06ec68e722c45a7218e23ea1bc1339fe4e21ecae
# The shared Weaver policies semconv-check runs beside kagent's own.
WEAVER_PACKAGES=https://github.com/open-telemetry/opentelemetry-weaver-packages.git@d84341cf20a1fef1a833ef44d318c41a770e6e64
