WEAVER_VERSION=v0.27.0
WEAVER_IMAGE=docker.io/otel/weaver:v0.27.0@sha256:3049b4079049d4abb1b5632f511ada2c33505a1c60f3f8535e93f87f0696f056
# The contract's upstream sources, each pinned by commit; `make semconv-deps`
# puts them in telemetry/deps. The core registry is the commit of v1.44.0.
SEMCONV_CORE_REGISTRY=https://github.com/open-telemetry/semantic-conventions.git@e10a930844c6951757a43b849d364f7d056ac32b
# semantic-conventions-genai has no releases yet; it is built into a Weaver package.
SEMCONV_GENAI_REGISTRY=https://github.com/open-telemetry/semantic-conventions-genai.git@06ec68e722c45a7218e23ea1bc1339fe4e21ecae
# The shared Weaver policies semconv-check runs beside kagent's own.
WEAVER_PACKAGES=https://github.com/open-telemetry/opentelemetry-weaver-packages.git@d84341cf20a1fef1a833ef44d318c41a770e6e64
